# Copie para .env e preencha. O backend RECUSA subir sem JWT_SECRET forte.

# --- API ---
PORT=3001
HOST=127.0.0.1          # so localhost; use 0.0.0.0 apenas atras de proxy/container
# CORS_ORIGINS=         # vazio = nenhuma origem cross-site (o Vite usa proxy na mesma origem)
# TRUST_PROXY=0         # nº de proxies reversos confiaveis (0 = ignora X-Forwarded-For)
# DB_PATH=./hvac.db

# --- Criptografia ---
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Primeiro administrador (criado so se ainda nao existir) ---
# Senha: 12+ caracteres com maiuscula, minuscula, numero e simbolo.
ADMIN_LOGIN=admin
ADMIN_SENHA=

# --- Anti-bot (valores padrao) ---
# RATE_LIMIT_MAX=300            # req/min por IP na API
# LOGIN_RATE_LIMIT_MAX=10       # tentativas de login por IP a cada 15 min
# LOGIN_MAX_FALHAS=5            # senhas erradas seguidas ate bloquear a conta
# LOGIN_BLOQUEIO_MS=900000      # 15 min de bloqueio
# TELEMETRIA_RATE_LIMIT_MAX=120 # leituras/min por dispositivo

# --- MQTT (opcional; sem MQTT_URL a ponte fica desligada) ---
# MQTT_URL=mqtts://SEU-BROKER:8883
# MQTT_TOPIC=
# MQTT_USERNAME=
# MQTT_PASSWORD=
# SALA_ID=1

# --- ntfy.sh (opcional) ---
# NTFY_ENABLED=true
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=          # node -e "console.log('hvac-'+require('crypto').randomBytes(16).toString('hex'))"
# NTFY_TOKEN=
